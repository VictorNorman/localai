# ── Tool implementations ──────────────────────────────────────────────────────

def confirm(prompt, default=True):
    suffix = "[Y/n]" if default else "[y/N]"
    response = input(f"{prompt} {suffix} ").strip().lower()
    if not response:
        return default
    return response.startswith("y")


# Paths the user has already made a write decision for, this session.
_write_decisions = {}


def tool_read_file(args):
    path = os.path.expanduser(args["path"])
    try:
        with open(path, "r", errors="replace") as f:
            return f.read()
    except Exception as e:
        return f"[error] {e}"


def tool_write_file(args):
    path = os.path.expanduser(args["path"])
    content = args.get("content", "")
    if path in _write_decisions:
        allowed = _write_decisions[path]
    else:
        print(f"\n  write_file: {path} ({len(content)} bytes)")
        allowed = confirm("  Allow this write?", default=True)
        _write_decisions[path] = allowed
    if not allowed:
        return "[denied by user]"
    try:
        d = os.path.dirname(path)
        if d:
            os.makedirs(d, exist_ok=True)
        with open(path, "w") as f:
            f.write(content)
        return f"wrote {len(content)} bytes to {path}"
    except Exception as e:
        return f"[error] {e}"


def tool_list_dir(args):
    path = os.path.expanduser(args["path"])
    try:
        return "\n".join(sorted(os.listdir(path)))
    except Exception as e:
        return f"[error] {e}"


DELETE_COMMAND_RE = re.compile(
    r"\b(rm|rmdir|unlink|shred)\b"
    r"|\bfind\b.*\s-delete\b"
    r"|\bdelete\b"
)


def tool_run_command(args):
    command = args["command"]
    print(f"\n  run_command: {command}")
    if DELETE_COMMAND_RE.search(command):
        print("  This command appears to delete files.")
        if not confirm("  Allow it to run?", default=False):
            return "[denied by user]"
    try:
        result = subprocess.run(
            command, shell=True, capture_output=True, text=True, timeout=60
        )
        return json.dumps(
            {
                "stdout": result.stdout[-4000:],
                "stderr": result.stderr[-4000:],
                "exit_code": result.returncode,
            }
        )
    except Exception as e:
        return f"[error] {e}"


DISPATCH = {
    "read_file": tool_read_file,
    "write_file": tool_write_file,
    "list_dir": tool_list_dir,
    "run_command": tool_run_command,
}


# ── API call ───────────────────────────────────────────────────────────────────

class ModelUnavailable(Exception):
    """Raised when the configured model is not served by the LocalAI instance."""

    def __init__(self, model, available):
        super().__init__(f"Model {model!r} is not available")
        self.model = model
        self.available = available


def models_url(api_url):
    """Derive the Open WebUI model-list endpoint from the chat-completions URL."""
    return re.sub(r"/chat/completions/?$", "/models", api_url)


# The server doesn't tag models by modality, so non-chat models are recognized by
# name (embedding, reranking, speech, and image-generation models).
NON_CHAT_PATTERN = re.compile(
    r"embed|rerank|whisper|tts|stt|speech|transcrib|dall-?e|stable-?diffusion|sdxl|flux|moderation|clip",
    re.IGNORECASE,
)


def is_chat_model(model):
    """Heuristic: True unless the model is disabled or its name suggests a non-chat type."""
    info = model.get("info") or {}
    if info.get("is_active") is False:
        return False
    return not NON_CHAT_PATTERN.search(model["id"])


def list_models(api_url, api_key):
    """Return a sorted list of chat-model ids the server offers, or None if the query fails."""
    req = urllib.request.Request(
        models_url(api_url),
        headers={
            "Authorization": f"Bearer {api_key}",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.load(resp)
        ids = [m["id"] for m in data.get("data", []) if m.get("id") and is_chat_model(m)]
        return sorted(set(ids))
    except (urllib.error.URLError, json.JSONDecodeError, OSError, AttributeError, KeyError):
        return None


def format_unavailable(err):
    lines = [f"Model {err.model!r} is not available on this server.", "Available models:"]
    lines += [f"  {i}. {m}" for i, m in enumerate(err.available, 1)]
    lines.append("Switch with: localai config set model <name>")
    return "\n".join(lines)


def prompt_model_switch(err):
    """Ask the user to pick a replacement model. Returns the new model id, or None."""
    print(f"\n{Fore.YELLOW}{format_unavailable(err).rsplit(chr(10), 1)[0]}{Style.RESET_ALL}")
    while True:
        try:
            choice = input("Pick a number or model name to switch (blank to cancel): ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return None
        if not choice:
            return None
        if choice.isdigit() and 1 <= int(choice) <= len(err.available):
            return err.available[int(choice) - 1]
        if choice in err.available:
            return choice
        print("  Not a valid choice.")


def call_api(messages, api_url, api_key, model):
    payload = json.dumps(
        {
            "model": model,
            "messages": messages,
            "tools": TOOLS,
            "stream": True,
        }
    ).encode()
    req = urllib.request.Request(
        api_url,
        data=payload,
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
        },
        method="POST",
    )

    content = ""
    tool_calls = {}
    finish_reason = None

    try:
        with urllib.request.urlopen(req) as resp:
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if not line.startswith("data: "):
                    continue
                data = line[len("data: "):]
                if data == "[DONE]":
                    break
                chunk = json.loads(data)
                choices = chunk.get("choices") or []
                if not choices:
                    # Usage-only or keep-alive chunks carry no choices.
                    continue
                choice = choices[0]
                delta = choice.get("delta") or {}
                if delta.get("content"):
                    content += delta["content"]
                for tc in delta.get("tool_calls") or []:
                    idx = tc["index"]
                    entry = tool_calls.setdefault(idx, {"id": None, "name": None, "arguments": ""})
                    if tc.get("id"):
                        entry["id"] = tc["id"]
                    fn = tc.get("function", {})
                    if fn.get("name"):
                        entry["name"] = fn["name"]
                    if fn.get("arguments"):
                        entry["arguments"] += fn["arguments"]
                if choice.get("finish_reason"):
                    finish_reason = choice["finish_reason"]
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")
        if e.code in (400, 404):
            available = list_models(api_url, api_key)
            if available and model not in available:
                raise ModelUnavailable(model, available)
        sys.exit(f"[http error] {e.code} {body}")
    except urllib.error.URLError as e:
        sys.exit(f"[connection error] {e}")

    ordered_calls = [tool_calls[i] for i in sorted(tool_calls)]
    return content, ordered_calls, finish_reason


# ── Turn logic ─────────────────────────────────────────────────────────────────

def run_turn(messages, api_url, api_key, model):
    """Runs one user turn to completion, handling any tool-call round trips."""
    while True:
        content, tool_calls, _finish_reason = call_api(messages, api_url, api_key, model)

        if tool_calls:
            messages.append(
                {
                    "role": "assistant",
                    "content": content,
                    "tool_calls": [
                        {
                            "id": tc["id"],
                            "type": "function",
                            "function": {"name": tc["name"], "arguments": tc["arguments"]},
                        }
                        for tc in tool_calls
                    ],
                }
            )
            for tc in tool_calls:
                try:
                    args = json.loads(tc["arguments"]) if tc["arguments"] else {}
                except json.JSONDecodeError:
                    args = {}
                fn = DISPATCH.get(tc["name"])
                result = fn(args) if fn else f"[error] unknown tool {tc['name']}"
                messages.append({"role": "tool", "tool_call_id": tc["id"], "content": str(result)})
            continue

        return content


def announce_model_switch(model):
    print(f"  Using {model!r} for this session only (config unchanged).")
    print(f"  To make it permanent: localai config set model {model}")


def mask_secret(value):
    if not value:
        return "<not set>"
    return "****" + value[-4:] if len(value) > 8 else "****"


def print_config(active_model=None):
    """Print each setting's saved value, env override, and (optionally) the model in use."""
    env_names = {"api_key": "LOCALAI_API_KEY", "model": "LOCALAI_MODEL", "url": "LOCALAI_URL"}
    disk = Config.load()
    for k, env_name in env_names.items():
        disk_val = disk.get(k)
        env_val = os.environ.get(env_name)
        if k == "api_key":
            disk_val = mask_secret(disk_val) if disk_val else None
            env_val = mask_secret(env_val) if env_val else None
        saved_text = repr(disk_val) if disk_val else "<not set>"
        env_text = repr(env_val) if env_val else "<not set>"
        print(f"  {k}: saved={saved_text}, env={env_text}")
    if active_model:
        print(f"  active model (this session): {active_model!r}")


def print_available_models(api_url, api_key):
    """Print the chat models the server offers."""
    available = list_models(api_url, api_key)
    if not available:
        print("Could not fetch the model list from the server.")
        return
    print("Available models:")
    for m in available:
        print(f"  {m}")


def print_ai_response(content):
    """Render AI response using rich's Markdown renderer."""
    console = Console()
    console.print(Markdown(content))


# ── Main ───────────────────────────────────────────────────────────────────────

def main():
    config = Config.get()
    api_key, model, api_url = config["api_key"], config["model"], config["url"]

    if not api_key or not model:
        sys.exit("LOCALAI_API_KEY and LOCALAI_MODEL must be set (see ~/.zshrc or ~/.localai/config.json)")

    # ── Handle config command ──────────────────────────────────────────────
    if len(sys.argv) > 1 and sys.argv[1] == "config":
        valid_keys = {"api_key": "LOCALAI_API_KEY", "model": "LOCALAI_MODEL", "url": "LOCALAI_URL"}
        if len(sys.argv) > 3 and sys.argv[2] in ("set", "update"):
            key, value = sys.argv[3], " ".join(sys.argv[4:]) if len(sys.argv) > 4 else ""
            if key not in valid_keys:
                sys.exit(f"Unknown config key: {key}. Valid: {', '.join(valid_keys)}")
            data = Config.load()
            data[key] = value
            Config.save(data)
            print(f"Saved {valid_keys[key]}={value!r} to {CONFIG_FILE}")
        elif len(sys.argv) > 3 and sys.argv[2] == "list" and sys.argv[3] == "model":
            print_available_models(api_url, api_key)
        else:
            print("# Current config:")
            print_config()
        return

    # ── Initialize messages ────────────────────────────────────────────────
    # Every run starts from a clean conversation -- nothing is auto-loaded.
    messages = [{"role": "system", "content": SYSTEM_PROMPT}]

    # ── Handle session management ──────────────────────────────────────────
    if len(sys.argv) > 1 and sys.argv[1] == "session":
        sub = sys.argv[2] if len(sys.argv) > 2 else None
        if sub == "save":
            if len(sys.argv) < 4:
                sys.exit("Usage: localai session save <name>")
            name = sys.argv[3]
            Session.save(name, messages)
            print(f"Session saved as {name!r}")
            return
        if sub == "load":
            if len(sys.argv) < 4:
                sys.exit("Usage: localai session load <name>")
            name = sys.argv[3]
            loaded = Session.load(name)
            if loaded is None:
                print(f"No saved session named {name!r}.")
                return
            print(f"Loaded {len(loaded)} message(s) from {name!r}")
            return
        if sub == "list":
            sessions = Session.list()
            if not sessions:
                print("No saved sessions.")
                return
            print(f"{'NAME':<24} {'MESSAGES':>8}  UPDATED")
            for s in sessions:
                print(f"{s['name']:<24} {s['count']:>8}  {s['updated']}")
            return
        if sub == "clear":
            if len(sys.argv) < 4:
                sys.exit("Usage: localai session clear <name>")
            name = sys.argv[3]
            if not Session.exists(name):
                print(f"No saved session named {name!r}.")
                return
            Session.delete(name)
            print(f"Deleted session {name!r}")
            return
        if sub == "info":
            if len(sys.argv) < 4:
                sys.exit("Usage: localai session info <name>")
            name = sys.argv[3]
            path = Session._path(name)
            if not path.exists():
                print(f"No saved session named {name!r}.")
                return
            mtime = os.path.getmtime(path)
            with open(path) as f:
                data = json.load(f)
            print(f"Session: {name}")
            print(f"File: {path}")
            print(f"Last modified: {datetime.fromtimestamp(mtime)}")
            print(f"Messages stored: {len(data.get('messages', []))}")
            return
        if sub == "export":
            if len(sys.argv) < 4:
                sys.exit("Usage: localai session export <name> [file]")
            name = sys.argv[3]
            loaded = Session.load(name)
            if loaded is None:
                print(f"No saved session named {name!r}.")
                return
            filename = sys.argv[4] if len(sys.argv) > 4 else f"{name}.json"
            with open(filename, "w") as f:
                json.dump(loaded, f, indent=2)
            print(f"Exported {len(loaded)} messages to {filename}")
            return
        print("Usage: localai session <save|load|list|clear|info|export> <name> [file]")
        return

    # ── Batch mode (single argument) ───────────────────────────────────────
    if len(sys.argv) > 1 and sys.argv[1] not in ("config", "session"):
        user_input = " ".join(sys.argv[1:])
        messages.append({"role": "user", "content": user_input})
        CommandHistory.save(user_input)
        try:
            print_ai_response(run_turn(messages, api_url, api_key, model))
        except ModelUnavailable as err:
            sys.exit(format_unavailable(err))
        return

    # ── Interactive mode ──────────────────────────────────────────────────
    current_session_name = None

    # Startup check: verify the configured model exists before the first message.
    # Best-effort -- if the model list can't be fetched, skip silently.
    available = list_models(api_url, api_key)
    if available and model not in available:
        new_model = prompt_model_switch(ModelUnavailable(model, available))
        if new_model:
            model = new_model
            announce_model_switch(model)
        print()

    print(f"Chatting with {model} (filesystem + shell tools enabled)")
    print("  Type 'exit' to quit, 'history' to view commands,")
    print("  'session save/load/list/info/clear <name>' to manage conversation history,")
    print("  'config set <key> <value>' to update settings, 'config' to show settings, 'config list model' to list models,")
    print("  'clear' to clear current conversation,")
    print("  '!' to run a shell command.")

    while True:
        try:
            GREEN  = "\001" + Fore.GREEN + "\002"
            RESET  = "\001" + Style.RESET_ALL + "\002"
            user_input = input(GREEN + "you > " + RESET)
        except EOFError:
            break

        stripped = user_input.strip()
        if stripped == "exit":
            if current_session_name:
                Session.save(current_session_name, messages)
                print(f"Session {current_session_name!r} saved. Goodbye.")
            else:
                print("Goodbye. (conversation was not saved -- use 'session save <name>' to keep it)")
            break
        if not stripped:
            continue

        # ── Special commands ─────────────────────────────────────────────
        if stripped == "clear":
            messages = [{"role": "system", "content": SYSTEM_PROMPT}]
            current_session_name = None
            print("Conversation cleared.")
            continue

        if stripped == "history":
            data = CommandHistory.load()
            cmds = data.get("commands", [])
            if cmds:
                print(f"\n  Last {len(cmds)} commands:")
                for i, cmd in enumerate(cmds[-20:], 1):
                    print(f"    {i:>3}. {cmd}")
            else:
                print("\n  No command history.")
            continue

        if stripped == "session" or stripped.startswith("session "):
            parts = stripped.split()
            sub = parts[1] if len(parts) > 1 else None

            if sub is None:
                print("\n  Session management:")
                print("    session save [name]  - save conversation (under current or given name)")
                print("    session load <name>  - load a saved conversation")
                print("    session list         - list saved sessions")
                print("    session info [name]  - view session metadata (default: active session)")
                print("    session clear <name> - delete a saved session")
            elif sub == "save":
                name = parts[2] if len(parts) > 2 else current_session_name
                if not name:
                    print("\n  Usage: session save <name>")
                else:
                    Session.save(name, messages)
                    current_session_name = name
                    print(f"\n  Session saved as {name!r}")
            elif sub == "load":
                if len(parts) < 3:
                    print("\n  Usage: session load <name>")
                else:
                    name = parts[2]
                    loaded = Session.load(name)
                    if loaded is None:
                        print(f"\n  No saved session named {name!r}.")
                    else:
                        messages = [{"role": "system", "content": SYSTEM_PROMPT}] + loaded
                        current_session_name = name
                        print(f"\n  Loaded {len(loaded)} message(s) from {name!r}")
            elif sub == "list":
                sessions = Session.list()
                if not sessions:
                    print("\n  No saved sessions.")
                else:
                    print(f"\n  {'NAME':<24} {'MESSAGES':>8}  UPDATED")
                    for s in sessions:
                        marker = "  *" if s["name"] == current_session_name else ""
                        print(f"  {s['name']:<24} {s['count']:>8}  {s['updated']}{marker}")
            elif sub == "info":
                name = parts[2] if len(parts) > 2 else current_session_name
                if not name:
                    print("\n  Usage: session info <name>  (or load/save a session first)")
                elif not Session.exists(name):
                    print(f"\n  No saved session named {name!r}.")
                else:
                    path = Session._path(name)
                    mtime = os.path.getmtime(path)
                    with open(path) as f:
                        data = json.load(f)
                    active = "  (active)" if name == current_session_name else ""
                    print(f"\n  Session: {name}{active}")
                    print(f"  File: {path}")
                    print(f"  Last modified: {datetime.fromtimestamp(mtime)}")
                    print(f"  Messages stored: {len(data.get('messages', []))}")
            elif sub == "clear":
                if len(parts) < 3:
                    print("\n  Usage: session clear <name>")
                else:
                    name = parts[2]
                    if not Session.exists(name):
                        print(f"\n  No saved session named {name!r}.")
                    else:
                        Session.delete(name)
                        if current_session_name == name:
                            current_session_name = None
                        print(f"\n  Deleted session {name!r}")
            else:
                print(f"\n  Unknown session command: {sub}")
            continue

        if stripped in ("config", "config list"):
            print()
            print_config(model)
            continue

        if stripped in ("config list model", "config list models"):
            print()
            print_available_models(api_url, api_key)
            continue

        if stripped.startswith("config set "):
            parts = stripped.split(" ", 3)
            if len(parts) >= 4:
                key, value = parts[2], parts[3]
                valid_keys_map = {"api_key": "LOCALAI_API_KEY", "model": "LOCALAI_MODEL", "url": "LOCALAI_URL"}
                if key not in valid_keys_map:
                    print(f"\n  Unknown config key: {key}. Valid: {', '.join(valid_keys_map)}")
                    continue
                disk_data = Config.load()
                disk_data[key] = value
                Config.save(disk_data)
                print(f"\n  Saved {valid_keys_map[key]}={value!r} to {CONFIG_FILE}")
            else:
                print("\n  Usage: config set <key> <value>")
            continue

        if stripped.startswith("!"):
            command = stripped[1:].strip()
            if command:
                try:
                    subprocess.run(command, shell=True)
                except KeyboardInterrupt:
                    print()
            CommandHistory.save(stripped)
            continue

        # ── Regular user message ─────────────────────────────────────────
        checkpoint = len(messages)
        messages.append({"role": "user", "content": user_input})
        CommandHistory.save(user_input)
        try:
            while True:
                try:
                    print_ai_response(run_turn(messages, api_url, api_key, model))
                    break
                except ModelUnavailable as err:
                    new_model = prompt_model_switch(err)
                    if not new_model:
                        del messages[checkpoint:]
                        print("(cancelled)")
                        break
                    model = new_model
                    announce_model_switch(model)
        except KeyboardInterrupt:
            del messages[checkpoint:]
            print("\n(interrupted)")

        # Keep a named session in sync after each turn, if one is active
        if current_session_name:
            Session.save(current_session_name, messages)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        # Conversations are only persisted via an explicit named
        # 'session save <name>', so there's nothing to auto-save here.
        print()
        sys.exit(0)

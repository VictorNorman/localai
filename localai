#!/usr/bin/env python3
"""CLI for Calvin's LocalAI (Open WebUI) instance, with filesystem/shell tool access.

Config comes from env vars or ~/.localai/config.json:
  LOCALAI_API_KEY, LOCALAI_MODEL, LOCALAI_URL
"""

import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

from colorama import Fore, Style, init
from rich.console import Console
from rich.markdown import Markdown

try:
    # macOS's stdlib `readline` is backed by libedit, which mis-renders
    # prompts containing more than one \001/\002 invisible-width span (it
    # hoists all of them to the front, breaking colored prompts). gnureadline
    # bundles real GNU readline and doesn't have that bug.
    import gnureadline as readline  # noqa: F401
except ImportError:
    import readline  # noqa: F401

init()

# ── Persistent storage paths ──────────────────────────────────────────────────
LOCALAI_DIR = Path.home() / ".localai"
CONFIG_FILE = LOCALAI_DIR / "config.json"
HISTORY_FILE = LOCALAI_DIR / "history.json"
SESSIONS_DIR = LOCALAI_DIR / "sessions"

# ── Config helpers ─────────────────────────────────────────────────────────────

class Config:
    """Persist and load configuration (API key, model, URL)."""

    DEFAULT_URL = "https://localai.calvin.edu/api/chat/completions"

    @classmethod
    def load(cls):
        if CONFIG_FILE.exists():
            with open(CONFIG_FILE) as f:
                data = json.load(f)
            return data
        return {}

    @classmethod
    def save(cls, data):
        LOCALAI_DIR.mkdir(parents=True, exist_ok=True)
        with open(CONFIG_FILE, "w") as f:
            json.dump(data, f, indent=2)

    @classmethod
    def get(cls):
        """Return config, preferring env vars, then disk, then defaults."""
        disk = cls.load()
        return {
            "api_key": os.environ.get("LOCALAI_API_KEY") or disk.get("api_key"),
            "model": os.environ.get("LOCALAI_MODEL") or disk.get("model"),
            "url": os.environ.get("LOCALAI_URL") or disk.get("url") or cls.DEFAULT_URL,
        }


# ── Session helpers ────────────────────────────────────────────────────────────

class Session:
    """Persist named conversation histories to disk.

    Nothing is loaded automatically -- every run starts from a clean
    conversation. Conversations are only written to disk when the user
    explicitly names and saves them (`session save <name>`).
    """

    @classmethod
    def _path(cls, name):
        safe = re.sub(r"[^A-Za-z0-9_-]+", "_", name).strip("_") or "session"
        return SESSIONS_DIR / f"{safe}.json"

    @classmethod
    def exists(cls, name):
        return cls._path(name).exists()

    @classmethod
    def load(cls, name):
        path = cls._path(name)
        if not path.exists():
            return None
        with open(path) as f:
            data = json.load(f)
        return data.get("messages", [])

    @classmethod
    def save(cls, name, messages):
        SESSIONS_DIR.mkdir(parents=True, exist_ok=True)
        with open(cls._path(name), "w") as f:
            json.dump(
                {
                    "name": name,
                    "messages": messages,
                    "updated": datetime.now().isoformat(),
                },
                f,
                indent=2,
            )

    @classmethod
    def delete(cls, name):
        cls._path(name).unlink(missing_ok=True)

    @classmethod
    def list(cls):
        """Return metadata for every saved session, newest first."""
        if not SESSIONS_DIR.exists():
            return []
        sessions = []
        for path in SESSIONS_DIR.glob("*.json"):
            try:
                with open(path) as f:
                    data = json.load(f)
            except Exception:
                continue
            sessions.append(
                {
                    "name": data.get("name", path.stem),
                    "updated": data.get("updated", ""),
                    "count": len(data.get("messages", [])),
                }
            )
        sessions.sort(key=lambda s: s["updated"], reverse=True)
        return sessions


# ── Command-history helpers ───────────────────────────────────────────────────

class CommandHistory:
    """Persist user command history across runs."""

    @classmethod
    def load(cls):
        if HISTORY_FILE.exists():
            with open(HISTORY_FILE) as f:
                data = json.load(f)
            for cmd in data.get("commands", [])[-200:]:  # keep last 200
                try:
                    readline.add_history(cmd)
                except Exception:
                    pass
            return data
        return {}

    @classmethod
    def save(cls, command):
        if not command or not command.strip():
            return
        LOCALAI_DIR.mkdir(parents=True, exist_ok=True)
        data = cls.load()
        commands = data.get("commands", [])
        commands.append(command)
        # Keep last 200 commands
        data["commands"] = commands[-200:]
        with open(HISTORY_FILE, "w") as f:
            json.dump(data, f, indent=2)



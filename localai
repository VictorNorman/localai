#!/usr/bin/env python3
"""CLI for Calvin's LocalAI (Open WebUI) instance, with filesystem/shell tool access.

Config comes from env vars or ~/.localai/config.json:
  LOCALAI_API_KEY, LOCALAI_MODEL, LOCALAI_URL
"""

import json
import os
import re
import shutil
import subprocess
import sys
import textwrap
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

from colorama import Fore, Style, init
from rich.console import Console
from rich.markdown import Markdown

try:
    # macOS's stdlib `readline` is backed by libedit, which mis-renders
    # prompts containing more than one \001/\002 invisible-width span (it
    # hoists all of them to the front, breaking colored prompts). gnureadline
    # bundles real GNU readline and doesn't have that bug.
    import gnureadline as readline  # noqa: F401
except ImportError:
    import readline  # noqa: F401

init()

# ── Persistent storage paths ──────────────────────────────────────────────────
LOCALAI_DIR = Path.home() / ".localai"
CONFIG_FILE = LOCALAI_DIR / "config.json"
HISTORY_FILE = LOCALAI_DIR / "history.json"
SESSION_FILE = LOCALAI_DIR / "current_session.json"

# ── Config helpers ─────────────────────────────────────────────────────────────

class Config:
    """Persist and load configuration (API key, model, URL)."""

    DEFAULT_URL = "https://localai.calvin.edu/api/chat/completions"

    @classmethod
    def load(cls):
        if CONFIG_FILE.exists():
            with open(CONFIG_FILE) as f:
                data = json.load(f)
            return data
        return {}

    @classmethod
    def save(cls, data):
        LOCALAI_DIR.mkdir(parents=True, exist_ok=True)
        with open(CONFIG_FILE, "w") as f:
            json.dump(data, f, indent=2)

    @classmethod
    def get(cls):
        """Return config, preferring env vars, then disk, then defaults."""
        disk = cls.load()
        return {
            "api_key": os.environ.get("LOCALAI_API_KEY") or disk.get("api_key"),
            "model": os.environ.get("LOCALAI_MODEL") or disk.get("model"),
            "url": os.environ.get("LOCALAI_URL") or disk.get("url") or cls.DEFAULT_URL,
        }


# ── Session helpers ────────────────────────────────────────────────────────────

class Session:
    """Persist conversation history between runs."""

    @classmethod
    def load(cls):
        if SESSION_FILE.exists():
            with open(SESSION_FILE) as f:
                data = json.load(f)
            return data.get("messages", [])
        return []

    @classmethod
    def save(cls, messages):
        LOCALAI_DIR.mkdir(parents=True, exist_ok=True)
        with open(SESSION_FILE, "w") as f:
            json.dump({"messages": messages, "updated": datetime.now().isoformat()}, f, indent=2)

    @classmethod
    def clear(cls):
        SESSION_FILE.unlink(missing_ok=True)


# ── Command-history helpers ───────────────────────────────────────────────────

class CommandHistory:
    """Persist user command history across runs."""

    @classmethod
    def load(cls):
        if HISTORY_FILE.exists():
            with open(HISTORY_FILE) as f:
                data = json.load(f)
            for cmd in data.get("commands", [])[-200:]:  # keep last 200
                try:
                    readline.add_history(cmd)
                except Exception:
                    pass
            return data
        return {}

    @classmethod
    def save(cls, command):
        if not command or not command.strip():
            return
        LOCALAI_DIR.mkdir(parents=True, exist_ok=True)
        data = cls.load()
        commands = data.get("commands", [])
        commands.append(command)
        # Keep last 200 commands
        data["commands"] = commands[-200:]
        with open(HISTORY_FILE, "w") as f:
            json.dump(data, f, indent=2)


# ── Global system prompt & tools ──────────────────────────────────────────────

SYSTEM_PROMPT = (
    "You are a helpful assistant with access to the local filesystem and shell "
    "via tools. Use read_file/list_dir to inspect things, write_file to create "
    "or modify files, and run_command to execute shell commands. Prefer the "
    "narrowest tool that accomplishes the task."
)

TOOLS = [
    {
        "type": "function",
        "function": {
            "name": "read_file",
            "description": "Read the contents of a text file.",
            "parameters": {
                "type": "object",
                "properties": {"path": {"type": "string"}},
                "required": ["path"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "write_file",
            "description": "Create or overwrite a text file with the given content.",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {"type": "string"},
                    "content": {"type": "string"},
                },
                "required": ["path", "content"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "list_dir",
            "description": "List files and directories at the given path.",
            "parameters": {
                "type": "object",
                "properties": {"path": {"type": "string"}},
                "required": ["path"],
            },
        },
    },
    {
        "type": "function",
        "function": {
            "name": "run_command",
            "description": "Execute a shell command and return stdout, stderr, and exit code.",
            "parameters": {
                "type": "object",
                "properties": {"command": {"type": "string"}},
                "required": ["command"],
            },
        },
    },
]


# ── Tool implementations ──────────────────────────────────────────────────────

def confirm(prompt):
    return input(f"{prompt} [y/N] ").strip().lower() == "y"


def tool_read_file(args):
    path = os.path.expanduser(args["path"])
    try:
        with open(path, "r", errors="replace") as f:
            return f.read()
    except Exception as e:
        return f"[error] {e}"


def tool_write_file(args):
    path = os.path.expanduser(args["path"])
    content = args.get("content", "")
    print(f"\n  write_file: {path} ({len(content)} bytes)")
    if not confirm("  Allow this write?"):
        return "[denied by user]"
    try:
        d = os.path.dirname(path)
        if d:
            os.makedirs(d, exist_ok=True)
        with open(path, "w") as f:
            f.write(content)
        return f"wrote {len(content)} bytes to {path}"
    except Exception as e:
        return f"[error] {e}"


def tool_list_dir(args):
    path = os.path.expanduser(args["path"])
    try:
        return "\n".join(sorted(os.listdir(path)))
    except Exception as e:
        return f"[error] {e}"


DELETE_COMMAND_RE = re.compile(
    r"\b(rm|rmdir|unlink|shred)\b"
    r"|\bfind\b.*\s-delete\b"
    r"|\bdelete\b"
)


def tool_run_command(args):
    command = args["command"]
    print(f"\n  run_command: {command}")
    if DELETE_COMMAND_RE.search(command):
        print("  This command appears to delete files.")
        if not confirm("  Allow it to run?"):
            return "[denied by user]"
    try:
        result = subprocess.run(
            command, shell=True, capture_output=True, text=True, timeout=60
        )
        return json.dumps(
            {
                "stdout": result.stdout[-4000:],
                "stderr": result.stderr[-4000:],
                "exit_code": result.returncode,
            }
        )
    except Exception as e:
        return f"[error] {e}"


DISPATCH = {
    "read_file": tool_read_file,
    "write_file": tool_write_file,
    "list_dir": tool_list_dir,
    "run_command": tool_run_command,
}


# ── API call ───────────────────────────────────────────────────────────────────

def call_api(messages, api_url, api_key, model):
    payload = json.dumps({"model": model, "messages": messages, "tools": TOOLS}).encode()
    req = urllib.request.Request(
        api_url,
        data=payload,
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
        },
        method="POST",
    )

    content = ""
    tool_calls = {}
    finish_reason = None

    try:
        with urllib.request.urlopen(req) as resp:
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if not line.startswith("data: "):
                    continue
                data = line[len("data: "):]
                if data == "[DONE]":
                    break
                chunk = json.loads(data)
                choice = chunk["choices"][0]
                delta = choice.get("delta", {})
                if delta.get("content"):
                    content += delta["content"]
                for tc in delta.get("tool_calls") or []:
                    idx = tc["index"]
                    entry = tool_calls.setdefault(idx, {"id": None, "name": None, "arguments": ""})
                    if tc.get("id"):
                        entry["id"] = tc["id"]
                    fn = tc.get("function", {})
                    if fn.get("name"):
                        entry["name"] = fn["name"]
                    if fn.get("arguments"):
                        entry["arguments"] += fn["arguments"]
                if choice.get("finish_reason"):
                    finish_reason = choice["finish_reason"]
    except urllib.error.HTTPError as e:
        sys.exit(f"[http error] {e.code} {e.read().decode(errors='replace')}")
    except urllib.error.URLError as e:
        sys.exit(f"[connection error] {e}")

    ordered_calls = [tool_calls[i] for i in sorted(tool_calls)]
    return content, ordered_calls, finish_reason


# ── Turn logic ─────────────────────────────────────────────────────────────────

def run_turn(messages, api_url, api_key, model):
    """Runs one user turn to completion, handling any tool-call round trips."""
    while True:
        content, tool_calls, _finish_reason = call_api(messages, api_url, api_key, model)

        if tool_calls:
            messages.append(
                {
                    "role": "assistant",
                    "content": content,
                    "tool_calls": [
                        {
                            "id": tc["id"],
                            "type": "function",
                            "function": {"name": tc["name"], "arguments": tc["arguments"]},
                        }
                        for tc in tool_calls
                    ],
                }
            )
            for tc in tool_calls:
                try:
                    args = json.loads(tc["arguments"]) if tc["arguments"] else {}
                except json.JSONDecodeError:
                    args = {}
                fn = DISPATCH.get(tc["name"])
                result = fn(args) if fn else f"[error] unknown tool {tc['name']}"
                messages.append({"role": "tool", "tool_call_id": tc["id"], "content": str(result)})
            continue

        return content


def print_ai_response(content):
    """Render AI response using rich's Markdown renderer."""
    console = Console()
    console.print(Markdown(content))


# ── Main ───────────────────────────────────────────────────────────────────────

def main():
    config = Config.get()
    api_key, model, api_url = config["api_key"], config["model"], config["url"]

    if not api_key or not model:
        sys.exit("LOCALAI_API_KEY and LOCALAI_MODEL must be set (see ~/.zshrc or ~/.localai/config.json)")

    # ── Handle config command ──────────────────────────────────────────────
    if len(sys.argv) > 1 and sys.argv[1] == "config":
        valid_keys = {"api_key": "LOCALAI_API_KEY", "model": "LOCALAI_MODEL", "url": "LOCALAI_URL"}
        if len(sys.argv) > 3 and sys.argv[2] in ("set", "update"):
            key, value = sys.argv[3], " ".join(sys.argv[4:]) if len(sys.argv) > 4 else ""
            if key not in valid_keys:
                sys.exit(f"Unknown config key: {key}. Valid: {', '.join(valid_keys)}")
            data = Config.load()
            data[key] = value
            Config.save(data)
            print(f"Saved {valid_keys[key]}={value!r} to {CONFIG_FILE}")
        else:
            print(f"# Current config (overrides via env vars are shown in parens):")
            for k in ("api_key", "model", "url"):
                env_var = os.environ.get(valid_keys[k], "<not set>")
                disk_val = config.get(k, "<not set>")
                print(f"#   {k}: disk={disk_val!r}, env={env_var!r}")
        return

    # ── Initialize messages ────────────────────────────────────────────────
    messages = [{"role": "system", "content": SYSTEM_PROMPT}]

    # Load existing session if available
    existing_session = Session.load()
    if existing_session:
        print(f"Continuing session with {len(existing_session)} previous message(s)")
        messages.extend(existing_session)

    # ── Handle session management ──────────────────────────────────────────
    if len(sys.argv) > 1 and sys.argv[1] == "session":
        if len(sys.argv) > 2 and sys.argv[2] == "save":
            Session.save(messages)
            print(f"Session saved to {SESSION_FILE}")
            return
        if len(sys.argv) > 2 and sys.argv[2] == "load":
            messages = Session.load()
            if not messages:
                print("No session history found.")
                return
            print(f"Loaded {len(messages)} messages from {SESSION_FILE}")
            # Rebuild messages with system prompt
            messages = [{"role": "system", "content": SYSTEM_PROMPT}] + messages
            return messages
        if len(sys.argv) > 2 and sys.argv[2] == "clear":
            Session.clear()
            print(f"Cleared session history from {SESSION_FILE}")
            return
        if len(sys.argv) > 2 and sys.argv[2] == "info":
            if SESSION_FILE.exists():
                import time
                mtime = os.path.getmtime(SESSION_FILE)
                print(f"Session file: {SESSION_FILE}")
                print(f"Last modified: {datetime.fromtimestamp(mtime)}")
                with open(SESSION_FILE) as f:
                    data = json.load(f)
                print(f"Messages stored: {len(data.get('messages', []))}")
            else:
                print("No session file found.")
            return
        if len(sys.argv) > 2 and sys.argv[2] == "export":
            messages = Session.load()
            if not messages:
                print("No session history to export.")
                return
            filename = sys.argv[3] if len(sys.argv) > 3 else "session.json"
            with open(filename, "w") as f:
                json.dump(messages, f, indent=2)
            print(f"Exported {len(messages)} messages to {filename}")
            return
        print("Usage: localai session <save|load|clear|info|export> [file]")
        return

    # ── Batch mode (single argument) ───────────────────────────────────────
    if len(sys.argv) > 1 and sys.argv[1] not in ("config", "session"):
        user_input = " ".join(sys.argv[1:])
        messages.append({"role": "user", "content": user_input})
        CommandHistory.save(user_input)
        print_ai_response(run_turn(messages, api_url, api_key, model))
        Session.save(messages)
        return

    # ── Interactive mode ──────────────────────────────────────────────────
    print(f"Chatting with {model} (filesystem + shell tools enabled)")
    print("  Type 'exit' to quit, 'history' to view commands,")
    print("  'session save/load/clear' to manage conversation history,")
    print("  'config set <key> <value>' to update settings,")
    print("  'clear' to clear current conversation,")
    print("  '!' to run a shell command.")

    while True:
        try:
            GREEN  = "\001" + Fore.GREEN + "\002"
            RESET  = "\001" + Style.RESET_ALL + "\002"
            user_input = input(GREEN + "you > " + RESET)
        except EOFError:
            break

        stripped = user_input.strip()
        if stripped == "exit":
            # Save before exiting
            Session.save(messages)
            print("Session saved. Goodbye.")
            break
        if not stripped:
            continue

        # ── Special commands ─────────────────────────────────────────────
        if stripped == "clear":
            messages = [{"role": "system", "content": SYSTEM_PROMPT}]
            Session.save(messages)
            print("Conversation cleared.")
            continue

        if stripped == "history":
            data = CommandHistory.load()
            cmds = data.get("commands", [])
            if cmds:
                print(f"\n  Last {len(cmds)} commands:")
                for i, cmd in enumerate(cmds[-20:], 1):
                    print(f"    {i:>3}. {cmd}")
            else:
                print("\n  No command history.")
            continue

        if stripped in ("session", "session save", "session load", "session clear"):
            if stripped == "session":
                print("\n  Session management:")
                print("    session save   - save current conversation")
                print("    session load   - load a saved conversation")
                print("    session clear  - clear saved conversation")
                print("    session info   - view session metadata")
                print("    session export <file> - export to file")
            elif stripped == "session save":
                Session.save(messages)
                print(f"\n  Session saved to {SESSION_FILE}")
            elif stripped == "session load":
                loaded = Session.load()
                if loaded:
                    messages = [{"role": "system", "content": SYSTEM_PROMPT}] + loaded
                    print(f"\n  Loaded {len(loaded)} message(s)")
                else:
                    print("\n  No saved session found.")
            elif stripped == "session clear":
                Session.clear()
                print("\n  Session history cleared.")
            continue

        if stripped.startswith("config set "):
            parts = stripped.split(" ", 3)
            if len(parts) >= 4:
                key, value = parts[2], parts[3]
                valid_keys_map = {"api_key": "LOCALAI_API_KEY", "model": "LOCALAI_MODEL", "url": "LOCALAI_URL"}
                if key not in valid_keys_map:
                    print(f"\n  Unknown config key: {key}. Valid: {', '.join(valid_keys_map)}")
                    continue
                disk_data = Config.load()
                disk_data[key] = value
                Config.save(disk_data)
                print(f"\n  Saved {valid_keys_map[key]}={value!r} to {CONFIG_FILE}")
            else:
                print("\n  Usage: config set <key> <value>")
            continue

        if stripped.startswith("!"):
            command = stripped[1:].strip()
            if command:
                try:
                    subprocess.run(command, shell=True)
                except KeyboardInterrupt:
                    print()
            CommandHistory.save(stripped)
            continue

        # ── Regular user message ─────────────────────────────────────────
        checkpoint = len(messages)
        messages.append({"role": "user", "content": user_input})
        CommandHistory.save(user_input)
        try:
            print_ai_response(run_turn(messages, api_url, api_key, model))
        except KeyboardInterrupt:
            del messages[checkpoint:]
            print("\n(interrupted)")

        # Save after each successful turn
        Session.save(messages)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        # Final save on Ctrl-C
        try:
            messages_save = messages if 'messages' in globals() else []
            Session.save(messages_save)
        except Exception:
            pass
        print()
        sys.exit(0)
